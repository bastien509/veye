{
  "manifest_version": 3,
  "name": "Veye – Scam Shield",
  "short_name": "Veye",
  "version": "1.0.0",
  "description": "Checks pages and messages for scams with Gemini Nano on your device first. Cloud fallback gets redacted text only.",
  "minimum_chrome_version": "139",
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab"],
  "host_permissions": ["https://petiht.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Veye – check this page",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
